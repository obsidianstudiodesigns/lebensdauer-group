<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lebensdauer Group - Afrihost Windows hosting (IIS on mindblast.aserv.co.za)

  This is the IIS equivalent of an .htaccess. Apache rules do NOT apply on this
  host, so .htaccess is not used here.

  If the site returns HTTP 500 after uploading, the host has locked one of these
  sections. Delete the <httpErrors> block first, then <urlCompression>, and
  retest - the rest is safe on shared hosting.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <httpErrors errorMode="Custom">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <staticContent>
      <!-- IIS refuses to serve extensions it has no MIME type for. The hero
           video is the one that bites; remove-then-add avoids a duplicate
           definition error if the server already defines it. -->
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />

      <!-- HTML kept short so content edits show up quickly -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:10:00" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!--
      HTTPS + www canonical redirect.

      Needs the IIS URL Rewrite module, which is NOT installed on every shared
      Windows plan - if it is missing, an uncommented <rewrite> block returns
      HTTP 500. Only enable this once SSL is active on the domain, and revert
      immediately if the site errors.

    <rewrite>
      <rules>
        <rule name="Force HTTPS and www" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^www\." negate="true" />
          </conditions>
          <action type="Redirect" url="https://www.lebensdauergroup.co.za/{R:1}"
                  redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    -->

  </system.webServer>

  <!-- Fingerprinted-by-name assets can cache hard; rename a file to bust it. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
