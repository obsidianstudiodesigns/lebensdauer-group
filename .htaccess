# Lebensdauer Group — Afrihost cPanel (LiteSpeed/Apache)
# Drop this in public_html alongside index.html.

DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Canonical host + HTTPS
#
# LEAVE THIS BLOCK COMMENTED until AutoSSL has issued a certificate for the
# domain (cPanel > SSL/TLS Status). Forcing HTTPS before the certificate
# exists takes the site offline. Once the padlock works on
# https://www.lebensdauergroup.co.za, remove the leading # from the six lines
# below — the site's canonical and Open Graph tags already point at www+https.
# ---------------------------------------------------------------------------
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^(.*)$ https://www.lebensdauergroup.co.za/$1 [R=301,L]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteCond %{HTTPS} =on
# RewriteRule ^(.*)$ https://www.lebensdauergroup.co.za/$1 [R=301,L]

# --- MIME types the hero video needs ---------------------------------------
AddType video/mp4  .mp4
AddType video/webm .webm

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Caching ----------------------------------------------------------------
# HTML stays short so content edits appear quickly; static assets are
# long-lived (rename the file to bust the cache).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 10 minutes"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType video/webm                "access plus 1 year"
</IfModule>

# --- Don't serve the source tree if it ever gets uploaded -------------------
RedirectMatch 404 (?i)^/(\.git|tools|Our\ work)/
